@model IReadOnlyList<DiscoverEgypt.Domain.Entities.Notification>
@* ملخص Member 6: صندوق إشعارات خاص بالمستخدم الحالي مع تعليم إشعار واحد أو الكل كمقروء. *@
@{ ViewData["Title"] = "الإشعارات"; }
<div class="d-flex justify-content-between align-items-center"><h1>الإشعارات</h1><form asp-action="MarkAllRead" method="post"><button class="btn btn-outline-primary">تعليم الكل كمقروء</button></form></div>
<div class="list-group mt-3">@foreach (var n in Model) { <article class="list-group-item @(n.IsRead ? "" : "list-group-item-info")"><div class="d-flex justify-content-between gap-3"><div><strong>@n.Type</strong><p class="mb-1">@n.Message</p><small>@n.CreatedAt.ToLocalTime().ToString("g")</small></div>@if (!n.IsRead) { <form asp-action="MarkRead" method="post"><input type="hidden" name="id" value="@n.Id"/><button class="btn btn-sm btn-outline-secondary">مقروء</button></form> }</div></article> }</div>
@if (Model.Count == 0) { <p class="mt-3">لا توجد إشعارات حتى الآن.</p> }
