@model IReadOnlyList<DiscoverEgypt.Domain.Entities.Experience>
@* ملخص Member 6: مراجعة ونشر التجارب أو رفضها، مع فحص وجود صورة قبل النشر. *@
@{ ViewData["Title"] = "التجارب"; }
<h1>إدارة التجارب</h1><div class="row g-3">
@foreach (var item in Model) { <div class="col-12"><article class="card"><div class="card-body"><h2 class="h5">@item.Title</h2><p>@item.ExperienceType.Name · المضيف #@item.HostProfileId · الحالة: @item.Status · الصور: @item.Media.Count(x => x.MediaType == DiscoverEgypt.Domain.Enums.MediaType.Image)</p><p>@item.Description</p><p><strong>القصة الثقافية:</strong> @item.CulturalStory</p><p>الأدلة الخاصة: @item.Evidence.Count · لا يتم عرض StorageKey أو رابط عام.</p>
@if (item.Status == DiscoverEgypt.Domain.Enums.ExperienceStatus.PendingApproval) { <form asp-action="ReviewExperience" method="post" class="row g-2"><input type="hidden" name="id" value="@item.Id"/><div class="col-md-7"><input name="reason" class="form-control" placeholder="سبب الرفض عند الحاجة" maxlength="1000"/></div><div class="col-auto"><button name="approve" value="true" class="btn btn-success">اعتماد ونشر</button></div><div class="col-auto"><button name="approve" value="false" class="btn btn-outline-danger">رفض</button></div></form> }
@foreach (var evidence in item.Evidence.Where(x => x.ReviewStatus == DiscoverEgypt.Domain.Enums.EvidenceReviewStatus.Pending)) { <div class="border rounded p-2 mt-2"><strong>دليل #@evidence.Id · @evidence.EvidenceKind</strong><form asp-action="ReviewEvidence" method="post" class="row g-2 mt-1"><input type="hidden" name="id" value="@evidence.Id"/><div class="col-md-7"><input name="note" class="form-control" placeholder="سبب الرفض عند الحاجة" maxlength="1000"/></div><div class="col-auto"><button name="approve" value="true" class="btn btn-sm btn-success">اعتماد الدليل</button></div><div class="col-auto"><button name="approve" value="false" class="btn btn-sm btn-outline-danger">رفض الدليل</button></div></form></div> }
@if (item.Status == DiscoverEgypt.Domain.Enums.ExperienceStatus.Unpublished) { <form asp-action="ReviewExperience" method="post"><input type="hidden" name="id" value="@item.Id"/><button name="approve" value="true" class="btn btn-success">إعادة النشر</button></form> }
@if (item.Status == DiscoverEgypt.Domain.Enums.ExperienceStatus.Published) { <form asp-action="UnpublishExperience" method="post"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-outline-danger">إلغاء النشر</button></form> }
</div></article></div> }
@if (Model.Count == 0) { <p>لا توجد تجارب بانتظار المراجعة.</p> }</div>
